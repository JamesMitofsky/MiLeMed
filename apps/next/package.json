{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.1.1",
  "scripts": {
    "dev": "yarn with-env next dev",
    "build": "cd ../.. && yarn build && cd apps/next && yarn next:build",
    "next:build": "yarn with-env next build",
    "start": "yarn with-env next start",
    "serve": "NODE_ENV=production yarn with-env next start --port 8151",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "with-env": "dotenv -e ../../.env -c --",
    "check:type": "tsc --outDir /tmp",
    "check:type:watch": "yarn check:type -w"
  },
  "dependencies": {
    "@chakra-ui/provider": "^2.4.2",
    "@chakra-ui/react": "^3.2.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@faker-js/faker": "^9.3.0",
    "@my/ui": "*",
    "@supabase/auth-helpers-nextjs": "^0.9.0",
    "@supabase/auth-helpers-react": "^0.4.2",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.39.3",
    "@tamagui/next-theme": "^1.125.31",
    "@tamagui/react-native-svg": "^1.125.31",
    "@tanstack/react-query": "4.18.0",
    "@trpc/server": "^10.45.1",
    "app": "*",
    "chart.js": "^4.4.7",
    "framer-motion": "^11.15.0",
    "next": "^14.0.4",
    "raf": "^3.4.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-web": "~0.19.10",
    "vercel": "latest",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^13.5.6",
    "@next/eslint-plugin-next": "^14.0.4",
    "@tamagui/next-plugin": "^1.125.31",
    "@types/node": "^18.6.4",
    "dotenv-cli": "^6.0.0"
  }
}
